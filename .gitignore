# dependencies and build output
node_modules/
dist/

# saved times of the local leaderboard (yours, not the project's)
data/

# test and benchmark output
test-results/
playwright-report/
bench-results/
coverage/

# never commit secrets or machine-specific files
.env
.env.*
*.pem
*.key
.DS_Store
*.log

# hidden tool folders (editors, assistants, hosting tools): nothing in them belongs in the repository
.*/
!.github/
